{
  "name": "dsh-session-bg",
  "version": "0.1.2",
  "private": true,
  "description": "按 sessionId 给对话栏配独立背景图：Host 提供配置/图片路由，Client 在会话头部挂载跟踪器，随会话切换换图。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.json",
    "bg.py",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
